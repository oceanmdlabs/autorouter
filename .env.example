# Database
DB_URL=postgresql://username:password@host:port/database?sslmode=require
# Optional DB driver override:
# - pg (default): requires DB_URL
# - aws-data-api-pg: Aurora PostgreSQL via RDS Data API (not direct endpoint)
#   requires DB_NAME + DB_RESOURCE_ARN + DB_SECRET_ARN + AWS_REGION
DB_DRIVER=pg
# DB_NAME=autorouter
# DB_RESOURCE_ARN=arn:aws:rds:region:account-id:cluster:cluster-name
# DB_SECRET_ARN=arn:aws:secretsmanager:region:account-id:secret:secret-name

# Encryption
ENCRYPTION_KEY=your_encryption_key_here

# Nuxt Session
NUXT_SESSION_PASSWORD=your_session_password_here

# OAuth - GitHub
NUXT_OAUTH_GITHUB_CLIENT_ID=Ov23liJqsvLu4U0L4Wei
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth - Google
NUXT_OAUTH_GOOGLE_CLIENT_ID=930213734007-387deb0pfj10k7rojkgl1t62lmpa0d26.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI/PHI processing is fail-closed. Leave disabled until the exact deployment
# has completed every gate in docs/privacy/ai-phi-policy.md.
AI_PHI_PROCESSING_ENABLED=false
# AI_PHI_DEPLOYMENT_APPROVAL_ID=approved-record-id
# AI_PHI_APPROVED_PROVIDER=bedrock
# AI_PHI_APPROVED_MODEL=exact-approved-direct-model-id
# AI_PHI_APPROVED_REGION=ca-central-1
# AI_PHI_RETENTION_MODE=none

# System Admin
# System admin is DB-backed via system_admin_allowlist (provider + subject).

# Application URL
URL=http://localhost:4000
DEPLOY_URL=http://localhost:4000

# Ocean Integration (for test script)
# OCEAN_SERVER can be: test, staging, ocean, local
OCEAN_SERVER=test
OCEAN_CLIENT_ID=your_ocean_client_id
OCEAN_CLIENT_SECRET=your_ocean_client_secret

# Optional: Custom test message
# TEST_MESSAGE=Your custom test message here
