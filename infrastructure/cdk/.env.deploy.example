# AWS deploy target
AWS_PROFILE=ocean-labs
AWS_REGION=ca-central-1

# Stack name (default is "dev"). Final stack name becomes: <CDK_STACK_NAME>-autorouter
# Names matching /prod/ auto-enable DB deletion protection + final snapshots.
CDK_STACK_NAME=dev

# Physical resource name prefix (default "ocean-autorouter"). All resources
# (Lambda, S3 bucket, Aurora cluster, VPC, etc.) are named "<NAME_PREFIX>-<x>".
# REQUIRED when deploying more than one site into the same AWS account/region:
# each site MUST use a distinct NAME_PREFIX or deploys collide on existing
# resource names (e.g. "ocean-autorouter-lambda already exists").
# NAME_PREFIX=ocean-autorouter

# Deploying multiple sites: keep one env file per site (e.g. .env.deploy.kwpeds)
# and point the deploy scripts at it with DEPLOY_ENV_FILE:
#   DEPLOY_ENV_FILE=$PWD/.env.deploy.kwpeds npm run cdk:deploy:app:env:migrate -- --profile "$AWS_PROFILE" --require-approval never

# Recommended for production/staging.
# Used for OAuth callbacks and app runtime URL vars.
# PUBLIC_URL=https://autorouter.example.com

# Optional: load deploy values from AWS Secrets Manager (JSON SecretString).
# If a key is set both here and in the secret, this file takes precedence.
# APP_SECRETS_SECRET_ID=ocean-autorouter/dev/app-secrets

# OAuth providers:
# - You can use Google, GitHub, or both.
# - At least one fully configured provider is needed for sign-in.
# - If either ID/secret is missing for a provider, deploy script skips that provider.

# Google OAuth (optional)
NUXT_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (optional)
NUXT_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
# NOTE: a GitHub OAuth app allows only ONE callback URL, so a single app cannot
# be reused across multiple sites. Use a dedicated GitHub app per site, or rely
# on Google (which allows multiple authorized redirect URIs).

# Optional OAuth redirect overrides (per-site).
# Normally the app auto-detects the redirect URI from the request and you can
# leave these unset. Pin them when reusing one OAuth app across hosts, OR when a
# local .env baked a NUXT_OAUTH_*_REDIRECT_URL into the build that would leak
# into this environment. Must point at THIS site's host + /auth/<provider>.
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://<this-site-host>/auth/google
# NUXT_OAUTH_GITHUB_REDIRECT_URL=https://<this-site-host>/auth/github

# Required app secrets
# NUXT_SESSION_PASSWORD:
#   Used by nuxt-auth-utils to encrypt/seal session cookies.
#   Use a strong random secret, at least 32 chars.
# ENCRYPTION_KEY:
#   Used to encrypt/decrypt stored site secrets and JWT signing fallback.
#   Keep stable across deployments or previously encrypted values may fail to decrypt.
NUXT_SESSION_PASSWORD=your_session_password
ENCRYPTION_KEY=your_encryption_key
JWT_SECRET=your_jwt_secret

# Database safety toggles.
# Default from stack name: on when CDK_STACK_NAME matches /prod/, off otherwise.
# Set explicitly for real client/production data on a non-"prod" stack name.
# DB_DELETION_PROTECTION=true
# DB_SKIP_FINAL_SNAPSHOT=false
