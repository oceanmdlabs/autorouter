{
  "name": "@ocean-autorouter/cdk-aws",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "audit": "npm audit --audit-level=critical",
    "audit:full": "npm audit",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy",
    "cdk:deploy:app": "NITRO_PRESET=aws_lambda npm --prefix ../.. run build && cdk deploy",
    "cdk:deploy:app:env": "./scripts/deploy-app-with-env.sh",
    "cdk:deploy:app:env:migrate": "./scripts/deploy-app-and-migrate.sh",
    "db:sql": "npm --prefix ../.. exec -- tsx ./scripts/execute-sql-aws.ts",
    "db:migrate:apply": "npm --prefix ../.. exec tsx ./scripts/apply-migrations-aws.ts",
    "cdk:destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
