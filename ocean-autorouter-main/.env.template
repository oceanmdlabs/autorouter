# Application
PORT=4000
HOST=localhost

# Session / security
NUXT_SESSION_PASSWORD=__REPLACE_WITH_STRONG_SESSION_PASSWORD
ENCRYPTION_KEY=__REPLACE_WITH_32BYTE_HEX_OR_KEY
USE_BACKGROUND_FUNCTIONS=false

# Database
# Example formats:
# TCP: postgresql://user:password@host:port/dbname
# Cloud SQL socket: postgresql://user:password@/dbname?host=/cloudsql/INSTANCE_CONNECTION_NAME
DB_URL=__REPLACE_WITH_DATABASE_URL

# OAuth / identity
NUXT_OAUTH_GOOGLE_CLIENT_ID=__REPLACE_WITH_GOOGLE_CLIENT_ID
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=__REPLACE_WITH_GOOGLE_CLIENT_SECRET

# System admin
SYSTEM_ADMIN_IDENTITY_PROVIDER=google
SYSTEM_ADMIN_USER_ID=__REPLACE_WITH_ADMIN_USER_ID

# URLs
URL=http://localhost:4000
HOST_URL=http://localhost:4000

# GCP / Vertex AI
GCP_PROJECT_ID=__REPLACE_WITH_PROJECT_ID
GCP_LOCATION=__REPLACE_WITH_LOCATION
GCP_CLIENT_EMAIL=__REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
# Store private keys securely. Prefer base64-encoding the key to keep it on one line,
# then decode at runtime. Do NOT commit raw multiline private keys.
GCP_PRIVATE_KEY=__REPLACE_WITH_BASE64_ENCODED_PRIVATE_KEY
GCP_DEFAULT_MODEL=__REPLACE_WITH_MODEL_NAME


# Logging - both optional will default to 'info' if not set
ENV_NAME=local
LOG_LEVEL=info



# Ocean Integration (for test script)
# OCEAN_SERVER can be: test, staging, ocean, local
OCEAN_SERVER=test
OCEAN_CLIENT_ID=your_ocean_client_id
OCEAN_CLIENT_SECRET=your_ocean_client_secret
# Optional: Custom test message
# TEST_MESSAGE=Your custom test message here