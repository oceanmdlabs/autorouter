{
  "name": "ocean-autorouter",
  "private": "true",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy:aws": "npm --prefix infrastructure/cdk run cdk:deploy:app:env:migrate -- --require-approval never",
    "login:aws": "aws sso login --profile ocean-autorouter",
    "logs:tail:aws": "npm --prefix infrastructure/cdk run logs:tail",
    "db:sql:aws": "npm --prefix infrastructure/cdk run db:sql --",
    "postinstall": "node src/scripts/setup-git-hooks.mjs && nuxt prepare",
    "db:migrate:apply:local": "tsx src/scripts/apply-local-migrations.ts",
    "db:migrate:apply:aws": "npm --prefix infrastructure/cdk run db:migrate:apply",
    "db:migrate:generate": "tsx src/scripts/run-guarded-drizzle.ts generate",
    "seed:test-data": "tsx src/scripts/seed-test-data.ts",
    "push": "tsx src/scripts/run-guarded-drizzle.ts push",
    "prepush:typecheck": "npx nuxi typecheck",
    "typecheck": "npx nuxi typecheck",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:send-communication": "tsx src/scripts/test-send-communication.ts"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^2.0.3",
    "@ai-sdk/google": "^2.0.6",
    "@ai-sdk/openai": "^2.0.15",
    "@aws-sdk/client-rds-data": "^3.999.0",
    "@aws-sdk/client-s3": "^3.1009.0",
    "@nuxt/icon": "^1.11.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.11.2",
    "@sentry/node": "^9.8.0",
    "@sentry/tracing": "^7.120.3",
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^13.1.0",
    "ai": "^5.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.41.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "lucide-vue-next": "^0.487.0",
    "nuxt": "^4.4.2",
    "nuxt-auth-utils": "^0.5.20",
    "nuxt-lucide-icons": "^1.0.5",
    "pg": "^8.14.1",
    "pinia": "^3.0.3",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.3.1",
    "shadcn-nuxt": "^1.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "twilio": "^5.5.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vue-sonner": "^1.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/devtools": "^3.2.3",
    "@types/crypto-js": "^4.2.2",
    "@types/fhir": "^0.0.41",
    "@types/node-fetch": "^2.6.12",
    "@types/pg": "^8.11.11",
    "@types/twilio": "^3.19.3",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.30.6",
    "netlify-cli": "^20.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "vue": "^3.5.30",
    "fast-xml-parser": "^5.3.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
