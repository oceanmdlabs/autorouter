{
  "name": "ocean-autorouter",
  "private": "true",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:aws": "node src/scripts/clean-nuxt-output.mjs && NITRO_PRESET=aws_lambda nuxt build",
    "dev": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy:aws": "npm --prefix infrastructure/cdk run cdk:deploy:app:env:migrate -- --require-approval never",
    "deploy:aws:app": "npm --prefix infrastructure/cdk run cdk:deploy:code:env",
    "deploy:aws:stack": "npm --prefix infrastructure/cdk run cdk:deploy:app:env -- --require-approval never",
    "login:aws": "aws sso login --profile ocean-autorouter",
    "logs:tail:aws": "npm --prefix infrastructure/cdk run logs:tail",
    "db:sql:aws": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem npm --prefix infrastructure/cdk run db:sql --",
    "postinstall": "node src/scripts/setup-git-hooks.mjs && nuxt prepare",
    "db:migrate:apply:local": "tsx src/scripts/apply-local-migrations.ts",
    "db:migrate:apply:aws": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem npm --prefix infrastructure/cdk run db:migrate:apply",
    "db:migrate:generate": "tsx src/scripts/run-guarded-drizzle.ts generate",
    "seed:test-data": "tsx src/scripts/seed-test-data.ts",
    "push": "tsx src/scripts/run-guarded-drizzle.ts push",
    "prepush:typecheck": "npx nuxi typecheck",
    "benchmark:typecheck": "node src/scripts/benchmark-pipeline.mjs --group typecheck",
    "benchmark:build": "node src/scripts/benchmark-pipeline.mjs --group build",
    "typecheck": "npx nuxi typecheck",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:send-communication": "tsx src/scripts/test-send-communication.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.193",
    "@ai-sdk/cohere": "3.0.68",
    "@ai-sdk/google": "3.0.131",
    "@ai-sdk/openai": "3.0.124",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1146.0",
    "@aws-sdk/client-rds-data": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-ses": "^3.1146.0",
    "@aws-sdk/credential-providers": "^3.1146.0",
    "@lucide/vue": "^1.52.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/node": "11.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "ai": "6.0.302",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "h3": "1.15.11",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pg": "^8.23.1",
    "pinia": "^4.0.3",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.10.5",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "twilio": "6.1.2",
    "uuid": "14.0.2",
    "vue": "^3.5.43",
    "vue-router": "5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/devtools": "4.0.0-beta.4",
    "@types/fhir": "^0.0.44",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "vue": "^3.5.43",
    "axios": "1.20.0",
    "fast-xml-parser": "5.11.2",
    "follow-redirects": "1.16.1",
    "form-data": "4.0.6",
    "jsondiffpatch": "0.7.6",
    "nanoid@3.3.12": "3.3.19",
    "picomatch@2.3.1": "2.3.2",
    "qs": "6.16.0",
    "yaml": "2.9.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@vue-macros/common": {
      "unplugin-utils": "0.3.2"
    },
    "radix-vue": {
      "nanoid": "5.1.16"
    },
    "vite": {
      "esbuild": "0.28.2"
    },
    "@nuxt/devtools": "4.0.0-beta.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
